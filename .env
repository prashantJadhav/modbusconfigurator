# Dot-source in EVERY PowerShell window that runs the gateway or UI:   . .\testkit\env.ps1
$DbPassword = "gateway123"
$env:GW_DB_HOST = "127.0.0.1"
$env:GW_DB_PORT = "5432"
$env:GW_DB_NAME = "edge_gateway"
$env:GW_DB_USER = "gateway"   
$env:GW_DB_PASSWORD = $DbPassword
$env:UI_SECRET_KEY = "dev-only-secret-change-me-0123456789abcdef"
$env:UI_ADMIN_PASSWORD = "Admin#12345"        # first-start admin password (UI forces a change)
$env:UI_HOST = "127.0.0.1"
$env:UI_PORT = "8088"
$env:GW_LOG_LEVEL = "INFO"
$env:GW_CONFIG_SYNC_S = "3"
Write-Host ="Environment set for this window."
UI_THEME="bootstrap"
UI_SECRET_KEY="dessv-only-secret-change-me-0123456789abcdef"

